# PostgreSQL 연결 문자열 (Supabase: Project Settings > Database > Connection string, Transaction pooler 권장)
DATABASE_URL=postgres://chungoh:chungoh@localhost:5432/chungoh
# 세션 서명 키 (32자 이상 임의 문자열). 생성: openssl rand -base64 32
SESSION_SECRET=
# 개인정보 암호화 키 (32바이트 base64). 생성: openssl rand -base64 32
ENCRYPTION_KEY=
# 토스페이먼츠 결제위젯 키. 아래는 토스 공식 문서의 공개 테스트 키. 운영 시 가맹 후 발급 키로 교체
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 사이트 주소 (결제 성공/실패 리디렉션에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 시드 관리자 계정
SEED_ADMIN_EMAIL=admin@chungoh.local
SEED_ADMIN_PASSWORD=
